import turtle
import random
import math
import time

screen = turtle.Screen()
screen.title("变幻表情笑脸")
screen.setup(width=400, height=400)
pen = turtle.Turtle()
pen.hideturtle()
pen.speed(0)
screen.tracer(0)


face_colors = ["yellow", "orange", "red", "purple", "blue", "green", "pink", "cyan"]
color_index = 0


def draw_face(color):
    """画脸蛋"""
    pen.penup()
    pen.goto(0, -100)
    pen.pendown()
    pen.color(color)
    pen.begin_fill()
    pen.circle(100)
    pen.end_fill()


def draw_one_eye(x, y, size, color="black"):
    """画单个眼睛的辅助函数"""
    pen.penup()
    pen.goto(x, y)
    pen.pendown()
    pen.color(color)
    pen.begin_fill()
    pen.circle(size)
    pen.end_fill()


def draw_arc(x, y, radius, start_angle, extent, direction=1):
    """画弧线的辅助函数 - 使用数学坐标计算"""
    pen.penup()
    start_rad = math.radians(start_angle)
    start_x = x + radius * math.cos(start_rad)
    start_y = y + radius * math.sin(start_rad)
    pen.goto(start_x, start_y)
    pen.pendown()


    steps = 30
    for i in range(steps + 1):
        current_angle = start_angle + (extent * direction) * (i / steps)
        rad = math.radians(current_angle)
        px = x + radius * math.cos(rad)
        py = y + radius * math.sin(rad)
        pen.goto(px, py)


def draw_eyes(eye_style="normal"):
    """画眼睛"""
    if eye_style == "normal":
        for x in [-35, 35]:
            draw_one_eye(x, 30, 12)

    elif eye_style == "big":
        for x in [-40, 40]:
            draw_one_eye(x, 25, 18)

    elif eye_style == "small":
        for x in [-30, 30]:
            draw_one_eye(x, 35, 6)

    elif eye_style == "angry":
        pen.pensize(4)
        pen.color("black")
        for x in [-40, 20]:
            pen.penup()
            pen.goto(x, 30)
            pen.pendown()
            pen.setheading(0)
            pen.forward(20)

    elif eye_style == "surprised":
        for x in [-35, 35]:
            draw_one_eye(x, 25, 15)
            draw_one_eye(x + 5, 30, 5, "white")

    elif eye_style == "sad":
        pen.pensize(3)
        pen.color("black")
        for x in [-35, 35]:
            draw_arc(x, 35, 15, 150, 60, -1)

    elif eye_style == "cry":
        for x in [-35, 35]:
            draw_one_eye(x, 25, 12)
            # 泪滴
            pen.penup()
            pen.goto(x, 5)
            pen.pendown()
            pen.color("blue")
            pen.begin_fill()
            pen.setheading(-90)
            pen.circle(5, 180)
            pen.setheading(0)
            pen.forward(10)
            pen.end_fill()


def draw_mouth(mouth_style="smile"):
    """画嘴巴 - 使用坐标点直接绘制"""
    pen.pensize(6)
    pen.color("black")

    if mouth_style == "smile":
        # 微笑弧线
        draw_arc(0, -10, 50, -140, 100, 1)

    elif mouth_style == "big_smile":
        # 大笑弧线
        draw_arc(0, -5, 55, -150, 120, 1)

    elif mouth_style == "sad":
        # 悲伤弧线（向下）
        draw_arc(0, -15, 50, -40, -100, 1)

    elif mouth_style == "angry":
        # 愤怒（直线）
        pen.penup()
        pen.goto(-40, -25)
        pen.pendown()
        pen.pensize(4)
        pen.setheading(0)
        pen.forward(80)

    elif mouth_style == "surprised":
        # 惊讶（O型嘴）
        pen.penup()
        pen.goto(0, -35)
        pen.pendown()
        pen.pensize(1)
        pen.color("black")
        pen.begin_fill()
        pen.circle(18)
        pen.end_fill()
        pen.penup()
        pen.goto(0, -30)
        pen.pendown()
        pen.color("white")
        pen.begin_fill()
        pen.circle(10)
        pen.end_fill()

    elif mouth_style == "kiss":
        # 亲亲（心形嘴）
        pen.penup()
        pen.goto(0, -20)
        pen.pendown()
        pen.pensize(2)
        pen.color("red")
        pen.begin_fill()
        pen.setheading(45)
        pen.forward(15)
        pen.circle(10, 200)
        pen.right(90)
        pen.circle(10, 200)
        pen.forward(15)
        pen.end_fill()

    elif mouth_style == "neutral":
        # 中性（一字嘴）
        pen.penup()
        pen.goto(-30, -20)
        pen.pendown()
        pen.pensize(4)
        pen.setheading(0)
        pen.forward(60)


def draw_smile():
    global color_index

    pen.clear()
    pen.penup()
    pen.goto(0, 0)
    pen.setheading(0)
    pen.pendown()


    valid_combinations = [
        ("normal", "smile"),
        ("normal", "big_smile"),
        ("small", "smile"),
        ("small", "big_smile"),
        ("big", "smile"),
        ("big", "big_smile"),
        ("sad", "sad"),
        ("sad", "neutral"),
        ("cry", "sad"),
        ("angry", "angry"),
        ("angry", "neutral"),
        ("surprised", "surprised"),
        ("surprised", "big_smile"),
        ("surprised", "smile"),
        ("big", "kiss"),
        ("normal", "kiss"),
        ("normal", "neutral"),
        ("small", "neutral"),
    ]


    selected_eye, selected_mouth = random.choice(valid_combinations)


    face_color = face_colors[color_index]
    color_index = (color_index + 1) % len(face_colors)


    draw_face(face_color)
    draw_eyes(selected_eye)
    draw_mouth(selected_mouth)

    screen.title(f"表情: {selected_eye} + {selected_mouth}")


def main():
    try:
        while True:
            draw_smile()
            screen.update()
            time.sleep(0.6)
            pen.clear()
            screen.update()
            time.sleep(0.3)
    except (turtle.Terminator, KeyboardInterrupt):

        print("程序已退出")
    except Exception as e:

        print(f"发生错误: {e}")


if __name__ == "__main__":
    main()
    turtle.done()
